---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="mx-auto min-h-screen max-w-5xl px-6 py-10">
      <header class="mb-10">
        <h1 class="text-3xl font-bold tracking-tight">ktak.dev</h1>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
