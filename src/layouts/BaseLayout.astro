---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "The portfolio of ktak",
  ogImage = "/favicon.webp",
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ktak.dev" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.webp" sizes="128x128" type="image/webp" />
    <link rel="apple-touch-icon" href="/favicon.webp" sizes="128x128" />
  </head>
  <body>
    <div class="mx-auto min-h-screen max-w-5xl px-6 py-10">
      <header class="mb-10">
        <h1 class="text-3xl font-bold tracking-tight">ktak.dev</h1>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
