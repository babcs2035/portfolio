---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 | ktak.dev">
  <section class="py-16 text-center">
    <p class="text-sm font-medium text-slate-500">404 Not Found</p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight">ページが見つかりません</h2>
    <p class="mt-8">
      <a
        href="/"
        class="inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 font-medium text-slate-900 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500"
      >
        トップページへ戻る
      </a>
    </p>
  </section>
</BaseLayout>
